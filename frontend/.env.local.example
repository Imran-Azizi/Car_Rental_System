# ── API URL ───────────────────────────────────────────────────────────────────
# Development: http://localhost:5000/api
# Production (Railway): https://your-backend.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Backend hostname for next/image (production only) ────────────────────────
# Set to your Railway backend hostname, e.g.: your-backend.up.railway.app
# NEXT_PUBLIC_BACKEND_HOST=your-backend.up.railway.app
