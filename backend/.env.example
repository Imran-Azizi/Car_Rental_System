# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL: copy the DATABASE_URL from Railway dashboard
# Local: postgresql://USER:PASSWORD@localhost:5432/afshar_car_rental
DATABASE_URL="postgresql://postgres:password@localhost:5432/afshar_car_rental"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-strong-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
# Example: https://afshar-car-rental.vercel.app,https://custom-domain.com
FRONTEND_URL="http://localhost:3000"
